# ============================================================================
# RAILWAY DEPLOYMENT - ENVIRONMENT VARIABLES
# ============================================================================
# Add these in Railway dashboard: Project Settings → Variables

# ----------------------------------------------------------------------------
# REQUIRED - Production Configuration
# ----------------------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=production

# Database - Neon PostgreSQL
# Get from: https://neon.tech → Project → Connection Details
DATABASE_URL=postgresql://username:password@your-neon-host.neon.tech/panaudio?sslmode=require

# Cloudinary - Image Storage
# Get from: https://cloudinary.com/console → Settings → API Keys
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# JWT Authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secure-random-string-min-32-characters

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=YourSecurePasswordHere123!

# CORS - Vercel Frontend URL
# Update after deploying frontend to Vercel
FRONTEND_URL=https://your-app.vercel.app

# ----------------------------------------------------------------------------
# OPTIONAL - Advanced Configuration
# ----------------------------------------------------------------------------

# Database Connection Pool (default: 20)
# DB_POOL_MAX=20

# JWT Token Expiration (default: 7d)
# JWT_EXPIRES_IN=7d

# File Upload Limits (default: 10MB)
# MAX_FILE_SIZE=10485760
